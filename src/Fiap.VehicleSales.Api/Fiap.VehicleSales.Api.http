@host = http://localhost:5000
@vehicleId = 11111111-1111-1111-1111-111111111111
@buyerToken = substitua-pelo-token-do-comprador
@serviceToken = substitua-pelo-token-client-credentials
@paymentCode = substitua-pelo-codigo-retornado-na-compra

### Sincronizar catálogo (software principal)
PUT {{host}}/api/internal/vehicles/{{vehicleId}}
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{
  "brand": "Toyota",
  "model": "Corolla",
  "year": 2022,
  "color": "Prata",
  "price": 120000
}

### Listar disponíveis
GET {{host}}/api/vehicles/available

### Iniciar compra
POST {{host}}/api/sales
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{
  "vehicleId": "{{vehicleId}}",
  "buyerCpf": "52998224725"
}

### Confirmar pagamento (software principal)
PUT {{host}}/api/sales/payments/{{paymentCode}}
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{
  "status": "Completed"
}

### Cancelar pagamento (software principal)
PUT {{host}}/api/sales/payments/{{paymentCode}}
Authorization: Bearer {{serviceToken}}
Content-Type: application/json

{
  "status": "Canceled"
}

### Listar vendidos
GET {{host}}/api/vehicles/sold
